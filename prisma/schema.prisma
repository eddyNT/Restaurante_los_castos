// Esquema del Sistema Web Restaurante.
// Local: MariaDB/MySQL (XAMPP). Para PostgreSQL en el hosting basta cambiar `provider`.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Sucursales ----------

model Branch {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  address   String
  phone     String?
  whatsapp  String?
  email     String?
  mapUrl    String?  @db.VarChar(500)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  hours      BranchHour[]
  tables     DiningTable[]
  products   BranchProduct[]
  orders     Order[]
  paymentQrs PaymentQr[]
  staff      UserBranch[]
  carts      Cart[]

  @@map("branches")
}

model BranchHour {
  id        String  @id @default(cuid())
  branchId  String
  dayOfWeek Int // 0 = domingo ... 6 = sábado
  opensAt   String // "08:00"
  closesAt  String // "22:00"
  isClosed  Boolean @default(false)

  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
  @@map("branch_hours")
}

// ---------- Usuarios y roles ----------

model Role {
  id    String @id @default(cuid())
  code  String @unique // SUPER_ADMIN | ADMIN | CUSTOMER
  name  String
  users User[]

  @@map("roles")
}

model User {
  id           String    @id @default(cuid())
  roleId       String
  email        String    @unique
  passwordHash String
  fullName     String
  phone        String?
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  deletedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  role           Role                 @relation(fields: [roleId], references: [id])
  branches       UserBranch[]
  addresses      Address[]
  cart           Cart?
  orders         Order[]
  statusChanges  OrderStatusHistory[]
  verifiedPays   Payment[]            @relation("PaymentVerifier")
  uploadedQrs    PaymentQr[]
  auditLogs      AuditLog[]

  @@map("users")
}

model UserBranch {
  userId   String
  branchId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@id([userId, branchId])
  @@map("user_branches")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String // Casa, Trabajo
  line      String
  reference String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("addresses")
}

// ---------- Menú ----------

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  sortOrder Int       @default(0)
  isVisible Boolean   @default(true)
  products  Product[]

  @@map("categories")
}

model Product {
  id          String    @id @default(cuid())
  categoryId  String
  name        String
  slug        String    @unique
  description String?   @db.Text
  imageUrl    String?   @db.VarChar(500)
  basePrice   Decimal   @db.Decimal(10, 2)
  isVisible   Boolean   @default(true)
  isFeatured  Boolean   @default(false)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  category       Category        @relation(fields: [categoryId], references: [id])
  branchProducts BranchProduct[]
  cartItems      CartItem[]
  orderItems     OrderItem[]

  @@map("products")
}

// Precio y disponibilidad por sucursal (si no hay fila, vale basePrice y está disponible)
model BranchProduct {
  branchId      String
  productId     String
  priceOverride Decimal? @db.Decimal(10, 2)
  isAvailable   Boolean  @default(true)

  branch  Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([branchId, productId])
  @@map("branch_products")
}

// ---------- Carrito ----------

model Cart {
  id        String     @id @default(cuid())
  userId    String     @unique
  branchId  String
  updatedAt DateTime   @updatedAt
  items     CartItem[]

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branch Branch @relation(fields: [branchId], references: [id])

  @@map("carts")
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  notes     String?

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([cartId, productId])
  @@map("cart_items")
}

// ---------- Mesas, pedidos y pagos ----------

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
}

model DiningTable {
  id       String      @id @default(cuid())
  branchId String
  number   String
  capacity Int         @default(4)
  status   TableStatus @default(FREE)
  qrToken  String      @unique

  branch Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders Order[]

  @@unique([branchId, number])
  @@map("tables")
}

enum OrderType {
  DINE_IN
  TAKEAWAY
  DELIVERY
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  CASH
  QR
}

enum PaymentStatus {
  PENDING
  VERIFIED
  REJECTED
}

model Order {
  id              String        @id @default(cuid())
  code            String        @unique
  branchId        String
  userId          String?
  tableId         String?
  type            OrderType
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus @default(PENDING)
  subtotal        Decimal       @db.Decimal(10, 2)
  deliveryFee     Decimal       @default(0) @db.Decimal(10, 2)
  total           Decimal       @db.Decimal(10, 2)
  customerName    String
  customerPhone   String
  deliveryAddress String?       @db.VarChar(500)
  notes           String?       @db.VarChar(500)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  branch   Branch               @relation(fields: [branchId], references: [id])
  user     User?                @relation(fields: [userId], references: [id])
  table    DiningTable?         @relation(fields: [tableId], references: [id])
  items    OrderItem[]
  history  OrderStatusHistory[]
  payments Payment[]

  @@index([branchId, status])
  @@index([userId])
  @@map("orders")
}

// Nombre y precio se copian al momento del pedido: cambiar el menú no altera el historial
model OrderItem {
  id          String  @id @default(cuid())
  orderId     String
  productId   String
  productName String
  unitPrice   Decimal @db.Decimal(10, 2)
  quantity    Int
  lineTotal   Decimal @db.Decimal(10, 2)
  notes       String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  changedBy String?
  createdAt DateTime    @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [changedBy], references: [id])

  @@map("order_status_history")
}

model PaymentQr {
  id            String   @id @default(cuid())
  branchId      String
  bankName      String
  accountHolder String
  imageUrl      String   @db.VarChar(500)
  isActive      Boolean  @default(false)
  uploadedBy    String
  createdAt     DateTime @default(now())

  branch   Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  uploader User      @relation(fields: [uploadedBy], references: [id])
  payments Payment[]

  @@map("payment_qrs")
}

model Payment {
  id          String        @id @default(cuid())
  orderId     String
  paymentQrId String?
  method      PaymentMethod
  amount      Decimal       @db.Decimal(10, 2)
  status      PaymentStatus @default(PENDING)
  proofUrl    String?       @db.VarChar(500)
  verifiedBy  String?
  verifiedAt  DateTime?
  createdAt   DateTime      @default(now())

  order     Order      @relation(fields: [orderId], references: [id], onDelete: Cascade)
  paymentQr PaymentQr? @relation(fields: [paymentQrId], references: [id])
  verifier  User?      @relation("PaymentVerifier", fields: [verifiedBy], references: [id])

  @@map("payments")
}

// ---------- Soporte ----------

model Setting {
  key   String @id
  value String @db.Text

  @@map("settings")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  changes   Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@map("audit_logs")
}
